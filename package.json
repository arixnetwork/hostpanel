{
  "name": "rabby-host",
  "version": "1.0.0",
  "description": "Rabby Host - a simple, beautiful, reliable local/self-hosting control panel for Debian Linux",
  "license": "MIT",
  "type": "commonjs",
  "bin": {
    "rabby-host": "./bin/rabby-host"
  },
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test \"test/unit/*.test.js\"",
    "test:unit": "node --test \"test/unit/*.test.js\"",
    "test:integration": "RABBY_INTEGRATION=1 node --test \"test/integration/*.test.js\""
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "express": "^4.21.2"
  }
}